# ==========================================
# CodeForge Root Environment Example
# ==========================================

# Backend API Configuration
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/codeforge
JWT_SECRET=replace_with_a_secure_random_64_char_secret_for_production
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Isolated Execution Runner Microservice (REM-P0-01)
# Local dev: http://127.0.0.1:5050 | Docker compose internal: http://runner:5050
RUNNER_SERVICE_URL=http://127.0.0.1:5050
RUNNER_SHARED_SECRET=replace_with_a_secure_random_32_char_secret_for_runner_hmac

# Frontend Client Configuration (Vite)
# In production, set to your public API host or leave empty if served behind a reverse proxy
VITE_API_BASE_URL=http://localhost:5000
