# ==========================================
# CodeForge Server Environment Configuration
# ==========================================

# Network Port
PORT=5000

# Application Environment ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Connection String (must start with mongodb:// or mongodb+srv://)
MONGO_URI=mongodb://127.0.0.1:27017/codeforge

# JSON Web Token Secret
# In production, use a high-entropy string of at least 32 characters:
# e.g. openssl rand -base64 48
JWT_SECRET=replace_with_a_secure_random_64_char_secret_for_production

# Allowed CORS Origins (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Express JSON Body Size Limit
REQUEST_BODY_LIMIT=100kb

# Maximum Concurrent Sandbox Container Executions
MAX_CONCURRENT_EXECUTIONS=5

# ==========================================
# Dedicated Execution Runner Microservice (REM-P0-01)
# ==========================================

# URL of the isolated execution runner microservice
# Local dev: http://127.0.0.1:5050 | Docker compose internal: http://runner:5050
RUNNER_SERVICE_URL=http://127.0.0.1:5050

# Shared secret for timing-safe HMAC-SHA256 mutual request authentication
# In production, use a high-entropy string of at least 32 characters:
# e.g. openssl rand -base64 32
RUNNER_SHARED_SECRET=replace_with_a_secure_random_32_char_secret_for_runner_hmac
